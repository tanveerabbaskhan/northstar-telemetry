---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Fast, zero-bloat web experiences powered by Astro.js." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-white text-slate-900 antialiased">
    <slot />
  </body>
</html>
