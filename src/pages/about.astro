---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="About — Northstar Telemetry">
  <Navbar />
  <main class="mx-auto max-w-4xl px-6 py-20">
    <p class="text-sm font-medium text-orange-600">About</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900">Engineered for speed and clarity.</h1>
    <p class="mt-6 text-lg leading-relaxed text-slate-600">
      We build lightweight Astro.js web applications designed to deploy cleanly from GitHub straight to Cloudflare Pages and Vercel edge networks.
    </p>
  </main>
  <Footer />
</Layout>
